/-
  Tools.GenImage

  ELF -> Lean image data, one module per function.

      lake exe gen-image ELF NM OUTDIR MODPREFIX [STACKTOP]

  `NM` is `llvm-nm -S --defined-only ELF`: it is used only for function boundaries
  (address, size). It is an untrusted hint. A wrong boundary makes a checked fact
  fail or describe the wrong range; it cannot make one hold that does not.

  For each sized text symbol (aliases at one address emitted once), the module
  `MODPREFIX.F_<addr>` holds:

    `base`      the address
    `words`     the encodings, read from the loaded segment that contains them
    `packed`    the same words as one little-endian `Nat`
    `prog`      `decode` of each word, as a literal
    `decode_ok` `decodeWords words = prog`, checked by the kernel
    `prog_packed` `prog = decodeWords (unpackWords packed len)`, checked by the kernel:
                the symbolic executor fetches instruction `i` through it
                (`getElem!_decodeWords_unpack`), one shift of `packed` per fetch, so that
                the kernel never walks `prog`

  `prog` is produced by `RiscvZkvm.Interpreter.decode`, the decoder `stepSp1` runs.
  The claim `decodeWords words = prog` is NOT trusted from here: it is what the
  kernel is asked to check.

  `MODPREFIX.Ro` is the read-only segment (the loadable segment that is neither writable
  nor executable) as chunks of 64 doublewords, `roChunk k`, and the case's
  `layout : AsmVerif.RiscV.Sym.Layout`: the code window (the extent of the code chunks),
  the read-only segment, and the stack top (`STACKTOP`, hex; default: the segment's base),
  with the layout's side conditions decided by the kernel.

  It also emits the loaded image as data for `AsmVerif.RiscV.Load`:

    `MODPREFIX.Data_<i>`  one module per segment: its doublewords, `.bss` as a zero count
    `MODPREFIX.Layout`    `image : Image`: entry, code chunks tiling every executable
                          segment (the function modules plus gap chunks), data chunks;
                          and `code_F_<addr> : image.code[k]? = some ⟨base, words⟩` per
                          function, the index facts the code lemmas take

  and cross-checks that image against riscv-zkvm's own `Interpreter.load` of the same
  ELF, entry by entry, in both directions (code map and memory map). That comparison is
  the one piece of executable glue left between the ELF and the kernel-checked facts.
-/

import RiscvZkvm.Rv64
import RiscvZkvm.Interpreter
import AsmVerif.RiscV.Load
import Tools.Elf

namespace Tools.GenImage

open RiscvZkvm.Rv64
open RiscvZkvm.Interpreter

open Tools.Elf

/-- A hexadecimal numeral. -/
def parseHex (s : String) : Option Nat :=
  s.toList.foldlM (fun acc c => (fun d => acc * 16 + d) <$> hexDigit? c) 0
where
  hexDigit? (c : Char) : Option Nat :=
    if '0' ≤ c && c ≤ '9' then some (c.toNat - '0'.toNat)
    else if 'a' ≤ c && c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
    else if 'A' ≤ c && c ≤ 'F' then some (c.toNat - 'A'.toNat + 10)
    else none

def packWords (ws : List (BitVec 32)) : Nat :=
  ws.foldr (fun w acc => w.toNat + (acc <<< 32)) 0

def fmtInstr (i : Option Instr) : String :=
  (repr i).pretty 100000

def emitModule (modName : String) (fn : Sym) (ws : List (BitVec 32)) : String := Id.run do
  let mut s := s!"/-\n  DO NOT EDIT -- generated by `lake exe gen-image`.\n\n  `{fn.name}`\n-/\n\n"
  s := s ++ "import AsmVerif.RiscV.Image\n\nset_option maxRecDepth 200000\n\n"
  s := s ++ s!"namespace {modName}\n\nopen RiscvZkvm.Rv64\n\n"
  s := s ++ s!"def base : BitVec 64 := 0x{hex fn.addr 16}#64\n\n"
  s := s ++ s!"def len : Nat := {ws.length}\n\n"
  s := s ++ "def words : List (BitVec 32) := [\n"
  s := s ++ ",\n".intercalate (ws.map fun w => s!"  0x{hex w.toNat 8}#32") ++ "]\n\n"
  s := s ++ s!"def packed : Nat := 0x{hex (packWords ws) 1}\n\n"
  s := s ++ "def prog : List (Option Instr) := [\n"
  s := s ++ ",\n".intercalate (ws.map fun w => "  " ++ fmtInstr (decode w)) ++ "]\n\n"
  s := s ++ "theorem decode_ok : AsmVerif.RiscV.decodeWords words = prog := by decide +kernel\n\n"
  s := s ++ "theorem prog_packed : prog = AsmVerif.RiscV.decodeWords (AsmVerif.RiscV.unpackWords packed len) := by\n  decide +kernel\n\n"
  s := s ++ s!"end {modName}\n"
  return s

/-- The read-only segment as 64-doubleword chunks, and the layout. -/
def emitRo (modPrefix : String) (roIdx : Nat) (c : AsmVerif.RiscV.DataChunk) (textLo textHi stackTop : Nat) :
    String := Id.run do
  let cells := c.words ++ List.replicate c.zeros 0
  let size := cells.length
  let nChunks := (size + 63) / 64
  let mut s := s!"/-\n  DO NOT EDIT -- generated by `lake exe gen-image`.\n\n"
  s := s ++ s!"  The read-only segment (data chunk {roIdx}): {8 * size} bytes at 0x{hex c.base.toNat 16}, as\n"
  s := s ++ s!"  {nChunks} chunks of 64 doublewords, and the layout the symbolic executor reads.\n-/\n\n"
  s := s ++ "import AsmVerif.RiscV.Sym.Layout\n" ++ s!"import {modPrefix}.Data_{roIdx}\n\n"
  s := s ++ "set_option maxRecDepth 200000\n\n"
  s := s ++ s!"namespace {modPrefix}.Ro\n\nopen RiscvZkvm.Rv64 AsmVerif.RiscV\n\n"
  s := s ++ s!"/-- The data chunk the segment is read from. -/\ndef roIdx : Nat := {roIdx}\n\n"
  let mut rest := cells
  let mut k := 0
  while !rest.isEmpty do
    let piece := rest.take 64
    rest := rest.drop 64
    s := s ++ s!"def roChunk{k} : List Word := [" ++ ", ".intercalate (piece.map fun w => s!"0x{hex w.toNat 16}#64") ++ "]\n"
    k := k + 1
  s := s ++ "\n/-- Chunk `k`; `[]` past the end. -/\ndef roChunk : Nat → List Word\n"
  for j in [0:nChunks] do
    s := s ++ s!"  | {j} => roChunk{j}\n"
  s := s ++ "  | _ => []\n\n"
  s := s ++ "/-- The chunks are the segment's cells, 64 at a time. -/\n"
  s := s ++ s!"theorem roChunk_eq : ∀ k, k < {nChunks} → roChunk k = ((Data_{roIdx}.chunk.words ++ List.replicate Data_{roIdx}.chunk.zeros 0).drop (64 * k)).take 64 := by\n  decide +kernel\n\n"
  s := s ++ "noncomputable def layout : Sym.Layout where\n"
  s := s ++ s!"  textLo := 0x{hex textLo 1}\n  textHi := 0x{hex textHi 1}\n"
  s := s ++ s!"  roBase := 0x{hex c.base.toNat 1}\n  roBytes := {8 * size}\n  roChunks := {nChunks}\n  roChunk := roChunk\n"
  s := s ++ s!"  stackTop := 0x{hex stackTop 1}\n"
  s := s ++ "  ro_fits := by decide +kernel\n  ro_aligned := by decide\n  ro_inMem := by decide\n"
  s := s ++ "  ro_text := by decide\n  text_le := by decide\n  text_inMem := by decide\n  stack_text := by decide\n\n"
  s := s ++ "/-- The layout's constants, as rewrite rules. -/\n"
  s := s ++ s!"theorem layout_textLo : layout.textLo = 0x{hex textLo 1} := rfl\n"
  s := s ++ s!"theorem layout_textHi : layout.textHi = 0x{hex textHi 1} := rfl\n"
  s := s ++ s!"theorem layout_roBase : layout.roBase = 0x{hex c.base.toNat 1} := rfl\n"
  s := s ++ s!"theorem layout_roBytes : layout.roBytes = {8 * size} := rfl\n"
  s := s ++ s!"theorem layout_roChunks : layout.roChunks = {nChunks} := rfl\n"
  s := s ++ s!"theorem layout_stackTop : layout.stackTop = 0x{hex stackTop 1} := rfl\n\n"
  s := s ++ s!"end {modPrefix}.Ro\n"
  return s

/-- The little-endian doublewords of every segment, as `Interpreter.load` computes them:
    from the segment's 8-aligned start to `vaddr + memsz`, over the union of all segments'
    file bytes, absent bytes zero. Trailing zero doublewords become a count. -/
def dataChunks (img : Elf64Image) : Array AsmVerif.RiscV.DataChunk := Id.run do
  let mut bytes : Std.HashMap Nat UInt8 := {}
  for seg in img.segments do
    for i in [0:seg.data.size] do
      bytes := bytes.insert (seg.vaddr + i) seg.data[i]!
  let mut out := #[]
  for seg in img.segments do
    let lo := seg.vaddr - seg.vaddr % 8
    let hi := seg.vaddr + seg.memsz
    let mut ws : Array Word := #[]
    let mut a := lo
    while a < hi do
      let v := (List.range 8).foldl (fun acc k => acc ||| ((bytes.getD (a + k) 0).toNat <<< (8 * k))) 0
      ws := ws.push (BitVec.ofNat 64 v)
      a := a + 8
    let n := (ws.toList.reverse.takeWhile (· == 0)).length
    out := out.push { base := BitVec.ofNat 64 lo, words := (ws.toList.take (ws.size - n)), zeros := n }
  return out

/-- One entry of the code tiling: a function module, or a gap given inline. -/
inductive Piece where
  | fn (id : String) (addr : Nat) (ws : List (BitVec 32))
  | gap (addr : Nat) (ws : List (BitVec 32))

def Piece.chunk : Piece → AsmVerif.RiscV.CodeChunk
  | .fn _ a ws | .gap a ws => { base := BitVec.ofNat 64 a, words := ws }

def Piece.src (modPrefix : String) : Piece → String
  | .fn id _ _ => s!"⟨{modPrefix}.{id}.base, {modPrefix}.{id}.words⟩"
  | .gap a ws =>
    let w := ", ".intercalate (ws.map fun w => s!"0x{hex w.toNat 8}#32")
    s!"⟨0x{hex a 16}#64, [{w}]⟩"

def emitData (modName : String) (c : AsmVerif.RiscV.DataChunk) : String := Id.run do
  let mut s := s!"/-\n  DO NOT EDIT -- generated by `lake exe gen-image`.\n-/\n\n"
  s := s ++ "import AsmVerif.RiscV.Load\n\nset_option maxRecDepth 200000\n\n"
  s := s ++ s!"namespace {modName}\n\nopen AsmVerif.RiscV\n\n"
  -- Data for the kernel only: `noncomputable` skips compiling a 20k-element literal.
  s := s ++ s!"noncomputable def chunk : DataChunk where\n  base := 0x{hex c.base.toNat 16}#64\n  zeros := {c.zeros}\n"
  s := s ++ "  words := [\n" ++ ",\n".intercalate (c.words.map fun w => s!"    0x{hex w.toNat 16}#64") ++ "]\n\n"
  s := s ++ s!"end {modName}\n"
  return s

/-- Compare the image as `AsmVerif.RiscV.Load` reads it with riscv-zkvm's `Interpreter.load`. -/
def crossCheck (elf : Elf64Image) (image : AsmVerif.RiscV.Image) : Except String String := do
  let ld := (load elf).state
  if ld.pc != image.entry then throw s!"entry: {ld.pc} vs {image.entry}"
  let mut n := 0
  for (a, i) in ld.code.toList do
    if image.codeAt a != some i then throw s!"code at {a}: load has {repr i}"
    n := n + 1
  for c in image.code do
    for j in [0:c.words.length] do
      let a := c.base + BitVec.ofNat 64 (4 * j)
      if image.codeAt a != ld.code[a]? then throw s!"code at {a}: load has none"
  let mut m := 0
  for (a, v) in ld.mem.toList do
    if image.memAt a != v then throw s!"mem at {a}: load {v}, image {image.memAt a}"
    m := m + 1
  for c in image.data do
    for j in [0:c.words.length + c.zeros] do
      let a := c.base + BitVec.ofNat 64 (8 * j)
      if image.memAt a != ld.mem.getD a 0 then throw s!"mem at {a}: image has an entry load lacks"
  return s!"{n} code entries and {m} memory doublewords agree with Interpreter.load"

def main (args : List String) : IO UInt32 := do
  let (elfPath, nmPath, outDir, modPrefix, stackTop?) ← match args with
    | [e, n, o, m] => pure (e, n, o, m, none)
    | [e, n, o, m, st] => pure (e, n, o, m, some st)
    | _ => IO.eprintln "usage: gen-image ELF NM OUTDIR MODPREFIX [STACKTOP]"; return 2
  let bytes ← IO.FS.readBinFile elfPath
  let img ← match parseElf64 bytes with
    | .ok img => pure img
    | .error e => IO.eprintln s!"gen-image: {e}"; return 1
  let fns := parseNm (← IO.FS.readFile nmPath)
  IO.FS.createDirAll outDir
  let mut index : Array String := #[]
  let mut pieces : Array Piece := #[]
  let mut total := 0
  let mut undecoded := 0
  -- Tile every executable segment: function chunks, gaps between them.
  for seg in img.segments do
    if !seg.executable then continue
    let segEnd := seg.vaddr + seg.data.size - (seg.data.size % 4)
    let mut cur := seg.vaddr
    for fn in fns do
      if fn.addr < cur || fn.addr + fn.size > segEnd then continue
      if fn.size % 4 != 0 || (fn.addr - seg.vaddr) % 4 != 0 then
        IO.eprintln s!"gen-image: {fn.name} is not word-aligned; skipped"
        continue
      if fn.addr > cur then
        match wordsAt img cur ((fn.addr - cur) / 4) with
        | .ok ws => pieces := pieces.push (.gap cur ws)
        | .error e => IO.eprintln s!"gen-image: gap at {cur}: {e}"; return 1
      let ws ← match wordsAt img fn.addr (fn.size / 4) with
        | .ok ws => pure ws
        | .error e => IO.eprintln s!"gen-image: {fn.name}: {e}"; return 1
      let id := s!"F_{hex fn.addr 8}"
      IO.FS.writeFile s!"{outDir}/{id}.lean" (emitModule s!"{modPrefix}.{id}" fn ws)
      index := index.push s!"{id}\t{hex fn.addr 8}\t{ws.length}\t{fn.name}"
      pieces := pieces.push (.fn id fn.addr ws)
      total := total + ws.length
      undecoded := undecoded + (ws.filter (decode · |>.isNone)).length
      cur := fn.addr + fn.size
    if cur < segEnd then
      match wordsAt img cur ((segEnd - cur) / 4) with
      | .ok ws => pieces := pieces.push (.gap cur ws)
      | .error e => IO.eprintln s!"gen-image: gap at {cur}: {e}"; return 1
  IO.FS.writeFile s!"{outDir}/INDEX.tsv" ("\n".intercalate index.toList ++ "\n")
  -- Data: one module per segment.
  let data := dataChunks img
  for h : i in [0:data.size] do
    IO.FS.writeFile s!"{outDir}/Data_{i}.lean" (emitData s!"{modPrefix}.Data_{i}" data[i])
  -- The image, and the cross-check against riscv-zkvm's loader.
  let image : AsmVerif.RiscV.Image :=
    { entry := BitVec.ofNat 64 img.entry, code := pieces.toList.map Piece.chunk, data := data.toList }
  match crossCheck img image with
  | .ok msg => IO.println s!"gen-image: {msg}"
  | .error e => IO.eprintln s!"gen-image: CROSS-CHECK FAILED: {e}"; return 1
  if !image.codeWF then IO.eprintln "gen-image: code chunks are not sorted and disjoint"; return 1
  -- The read-only segment and the layout.
  let roSegs := img.segments.filter fun seg => !seg.writable && !seg.executable
  let some roSeg := roSegs[0]? | IO.eprintln "gen-image: no read-only segment"; return 1
  if roSegs.size > 1 then IO.eprintln s!"gen-image: {roSegs.size} read-only segments; taking the first"
  let roLo := roSeg.vaddr - roSeg.vaddr % 8
  let some roIdx := (List.range data.size).find? fun i => (data[i]?.map fun c => c.base.toNat) == some roLo
    | IO.eprintln "gen-image: read-only segment has no data chunk"; return 1
  let some roChunk := data[roIdx]? | IO.eprintln "gen-image: read-only segment index"; return 1
  let textLo := (pieces.toList.map fun p => p.chunk.base.toNat).foldl min (2 ^ 64)
  let textHi := (pieces.toList.map fun p => p.chunk.hi).foldl max 0
  let stackTop ← match stackTop? with
    | none => pure roLo
    | some st =>
      let st := if st.startsWith "0x" then (st.drop 2).toString else st
      match parseHex st with
      | some v => pure v
      | none => IO.eprintln s!"gen-image: bad STACKTOP {st}"; return 1
  IO.FS.writeFile s!"{outDir}/Ro.lean" (emitRo modPrefix roIdx roChunk textLo textHi stackTop)
  let imports := (pieces.toList.filterMap fun | .fn id _ _ => some s!"import {modPrefix}.{id}" | _ => none) ++
    (List.range data.size).map (fun i => s!"import {modPrefix}.Data_{i}")
  let codeSrc := ",\n    ".intercalate (pieces.toList.map (Piece.src modPrefix))
  let codeIdx : Array (String × Nat) := Id.run do
    let mut out := #[]
    let mut k := 0
    for p in pieces do
      if let .fn id _ _ := p then out := out.push (id, k)
      k := k + 1
    return out
  let dataSrc := ", ".intercalate ((List.range data.size).map fun i => s!"{modPrefix}.Data_{i}.chunk")
  let layout := s!"/-\n  DO NOT EDIT -- generated by `lake exe gen-image`.\n\n" ++
    s!"  The loaded image of `{elfPath}`. gen-image checked, entry by entry, that\n" ++
    "  `AsmVerif.RiscV.Load` reads it exactly as riscv-zkvm's `Interpreter.load` does.\n-/\n\n" ++
    "import AsmVerif.RiscV.Load\n" ++ "\n".intercalate imports ++
    "\n\nset_option maxRecDepth 200000\n\n" ++
    s!"namespace {modPrefix}.Layout\n\nopen AsmVerif.RiscV\n\n" ++
    s!"noncomputable def image : Image where\n  entry := 0x{hex img.entry 16}#64\n" ++
    s!"  code := [\n    {codeSrc}]\n  data := [{dataSrc}]\n\n" ++
    "/-! Each function module's chunk, at its index in `image.code`. -/\n\n" ++
    "\n".intercalate (codeIdx.toList.map fun (id, k) =>
      s!"theorem code_{id} : image.code[{k}]? = some ⟨{modPrefix}.{id}.base, {modPrefix}.{id}.words⟩ := rfl") ++
    s!"\n\nend {modPrefix}.Layout\n"
  IO.FS.writeFile s!"{outDir}/Layout.lean" layout
  let gaps := (pieces.filter fun | .gap .. => true | _ => false).size
  IO.println s!"gen-image: {index.size} functions, {gaps} gaps, {total} function words, {undecoded} that decode to none, {data.size} data chunks, read-only segment = data chunk {roIdx}, text [0x{hex textLo 1}, 0x{hex textHi 1}), stack top 0x{hex stackTop 1}"
  return 0

end Tools.GenImage

def main (args : List String) : IO UInt32 := Tools.GenImage.main args
