theorem run_steps : run 0 (0, 0) steps = some (PALLAS_SCALAR_CARD, (0, 0)) := by decide +kernel

theorem binNsmul_q : binNsmul (add 0) (0, 0) PALLAS_SCALAR_CARD G = (0, 0) :=
  run_spec steps 0 (0, 0) _ _ (binNsmul_zero _ _ _) run_steps

/-- `binNsmul` commutes with a map that carries one addition and zero to the other. -/
theorem binNsmul_map {M N : Type*} {addM : M → M → M} {zM : M} {addN : N → N → N} {zN : N}
    (f : M → N) (hadd : ∀ a b, f (addM a b) = addN (f a) (f b)) (hz : f zM = zN) (n : Nat) (x : M) :
    f (binNsmul addM zM n x) = binNsmul addN zN n (f x) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    conv_lhs => rw [binNsmul]
    conv_rhs => rw [binNsmul]
    by_cases h0 : n = 0
    · simp only [h0, dif_pos]; exact hz
    · simp only [h0, dif_neg, not_false_eq_true]
      have := ih (n / 2) (Nat.div_lt_self (Nat.pos_of_ne_zero h0) (by decide))
      split_ifs <;> simp only [hadd, this]

/-- `[q] (-1, 2) = 𝒪` on Pallas, `q = PALLAS_SCALAR_CARD`: a kernel check of the certificate. -/
theorem q_nsmul_G (P : SWPoint curve) (hP : (P.x, P.y) = G) : PALLAS_SCALAR_CARD • P = 0 := by
  refine SWPoint.ext_pair ?_
  have hm := binNsmul_map (addM := sw_add) (zM := SWPoint.zero curve) (addN := add 0) (zN := (0, 0))
    (fun P : SWPoint curve => (P.x, P.y)) (fun _ _ => rfl) rfl PALLAS_SCALAR_CARD P
  rw [hP] at hm
  exact hm.trans binNsmul_q

end CompElliptic.Curves.Pasta.Pallas
