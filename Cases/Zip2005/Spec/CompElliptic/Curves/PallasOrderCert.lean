import Cases.Zip2005.Spec.CompElliptic.Curves.Pasta
import Cases.Zip2005.Spec.CompElliptic.ScalarMul

set_option autoImplicit false

/-!
# The order of the Pallas test point, by a checked certificate

`[q] (-1, 2) = 𝒪` on Pallas (`q = PALLAS_SCALAR_CARD`), the prime-order witness `PastaOrder`
uses, by kernel computation instead of `native_decide`. Double-and-add over `q`'s bits is
recorded as a certificate (`steps`): each doubling and each addition of `G` with the point it
gives and its slope. `addOk` checks one affine addition against its slope by a multiplication
(`λ · den = num`, `den ≠ 0`), so no field inversion is evaluated; `run_spec` turns a checked run
into `binNsmul`'s value, and `decide +kernel` checks the run. The certificate's numbers are data:
only the checks are trusted, and they are the kernel's.
-/

namespace CompElliptic.Curves.Pasta.Pallas

open CompElliptic.CurveForms.ShortWeierstrass CompElliptic.Fields.Pasta

/-- `R = add 0 P Q`, checked with the slope `lam` in place of a field inversion. -/
def addOk (P Q R : PallasBaseField × PallasBaseField) (lam : PallasBaseField) : Bool :=
  if P = (0, 0) then decide (R = Q)
  else if Q = (0, 0) then decide (R = P)
  else if P.1 = Q.1 then
    if P.2 + Q.2 = 0 then decide (R = (0, 0))
    else decide (2 * P.2 ≠ 0) && decide (lam * (2 * P.2) = 3 * P.1 ^ 2 + 0) &&
      decide (R = (lam ^ 2 - P.1 - Q.1, lam * (P.1 - (lam ^ 2 - P.1 - Q.1)) - P.2))
  else decide (Q.1 - P.1 ≠ 0) && decide (lam * (Q.1 - P.1) = Q.2 - P.2) &&
    decide (R = (lam ^ 2 - P.1 - Q.1, lam * (P.1 - (lam ^ 2 - P.1 - Q.1)) - P.2))

theorem add_of_addOk {P Q R : PallasBaseField × PallasBaseField} {lam : PallasBaseField}
    (h : addOk P Q R lam = true) : add 0 P Q = R := by
  unfold addOk at h
  unfold add
  split_ifs at h ⊢ with h1 h2 h3 h4
  · exact (of_decide_eq_true h).symm
  · exact (of_decide_eq_true h).symm
  · exact (of_decide_eq_true h).symm
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨hd, hl⟩, hR⟩ := h
    rw [hR, ← eq_div_of_mul_eq hd hl]
  · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨hd, hl⟩, hR⟩ := h
    rw [hR, ← eq_div_of_mul_eq hd hl]

/-- One bit of double-and-add: the doubling `D` and the sum `R` (`D + G` on a set bit), with
    their slopes. -/
structure Step where
  bit : Bool
  D : PallasBaseField × PallasBaseField
  ld : PallasBaseField
  R : PallasBaseField × PallasBaseField
  la : PallasBaseField

/-- Follow the steps from `[n] G = P`, checking each; the scalar and the point reached. -/
def run : Nat → PallasBaseField × PallasBaseField → List Step →
    Option (Nat × (PallasBaseField × PallasBaseField))
  | n, P, [] => some (n, P)
  | n, P, s :: ss =>
    if addOk P P s.D s.ld && (if s.bit then addOk s.D G s.R s.la else decide (s.R = s.D)) then
      run (2 * n + if s.bit then 1 else 0) s.R ss
    else none

/-- Double-and-add, one bit: `[2n + b] G` from `[n] G`. -/
theorem binNsmul_bit (n : Nat) (b : Bool) :
    binNsmul (add 0) (0, 0) (2 * n + if b then 1 else 0) G =
      let d := add 0 (binNsmul (add 0) (0, 0) n G) (binNsmul (add 0) (0, 0) n G)
      if b then add 0 d G else d := by
  by_cases h0 : 2 * n + (if b then 1 else 0) = 0
  · have hn : n = 0 := by omega
    have hb : b = false := by cases b <;> simp_all
    subst hn hb
    show binNsmul (add 0) (0, 0) 0 G = add 0 (binNsmul (add 0) (0, 0) 0 G) (binNsmul (add 0) (0, 0) 0 G)
    rw [binNsmul_zero]
    exact (if_pos rfl).symm
  · rw [binNsmul]
    simp only [h0, dif_neg, not_false_eq_true]
    have e1 : (2 * n + if b then 1 else 0) / 2 = n := by split <;> omega
    rw [e1]
    cases b <;> simp

theorem run_spec : ∀ (ss : List Step) (n : Nat) (P : PallasBaseField × PallasBaseField)
    (N : Nat) (Q : PallasBaseField × PallasBaseField),
    binNsmul (add 0) (0, 0) n G = P → run n P ss = some (N, Q) → binNsmul (add 0) (0, 0) N G = Q
  | [], n, P, N, Q, hP, h => by
    simp only [run, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact hP
  | ⟨bit, D, ld, R, la⟩ :: ss, n, P, N, Q, hP, h => by
    simp only [run] at h
    by_cases hok : (addOk P P D ld && (if bit then addOk D G R la else decide (R = D))) = true
    · rw [if_pos hok] at h
      refine run_spec ss _ R N Q ?_ h
      simp only [Bool.and_eq_true] at hok
      obtain ⟨hD, hR⟩ := hok
      rw [binNsmul_bit, hP, add_of_addOk hD]
      cases bit
      · simp only [Bool.false_eq_true, if_false, decide_eq_true_eq] at hR ⊢
        exact hR.symm
      · simp only [if_true] at hR ⊢
        exact add_of_addOk hR
    · rw [if_neg hok] at h
      exact absurd h (by simp)

