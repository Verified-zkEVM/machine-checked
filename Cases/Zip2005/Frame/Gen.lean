/-
  Cases.Zip2005.Frame.Gen

  Emit the frame annotation of each spike function as a Lean literal.

      lake env lean --run Cases/Zip2005/Frame/Gen.lean

  The annotation is an untrusted certificate: `Fn.analyze` computes it here, in compiled or
  interpreted code, and the kernel only re-checks it with `Fn.valid`, one pass over the
  instructions. Running the fixpoint itself in the kernel cost 593 s and 26 GB for one
  471-instruction function, and overflowed the kernel's recursion depth on another.
-/

import AsmVerif.RiscV.Frame.Domain
import Cases.Zip2005.Frame.Fns

namespace Cases.Zip2005.Frame.Gen

open RiscvZkvm.Rv64 AsmVerif.RiscV.Frame

def regName (r : Reg) : String := s!".x{regIdx r}"

def word (w : Word) : String := s!"0x{w.toHex}#64"

def fmtAVal : AVal → String
  | .lin r k => s!"(.lin {regName r} {word k})"
  | .const c => s!"(.const {word c})"
  | .top => ".top"
  | .oneOf cs => s!"(.oneOf [{", ".intercalate (cs.map word)}])"
  | .cell r ks k => s!"(.cell {regName r} [{", ".intercalate (ks.map word)}] {word k})"
  | .sym i j k => s!"(.sym {i} {j} {word k})"

def fmtState (A : AState) : String :=
  let regs := ", ".intercalate (A.regs.map fmtAVal)
  let slots := ", ".intercalate (A.slots.map fun (k, v) => s!"({word k}, {fmtAVal v})")
  s!"some \{ regs := [{regs}], slots := [{slots}] }"

def emit (name : String) (f : Fn) : IO Unit := do
  let some anno := f.analyze | throw <| IO.userError s!"{name}: the analysis did not converge"
  let r := f.report anno
  if !r.ok then throw <| IO.userError s!"{name}: the analysis result does not check"
  let entries := anno.toList.map fun
    | some A => fmtState A
    | none => "none"
  let body := ",\n  ".intercalate entries
  let src := s!"/-\n  DO NOT EDIT -- generated by `lake env lean --run Cases/Zip2005/Frame/Gen.lean`.\n\n" ++
    s!"  The frame annotation of `{name}`: an untrusted certificate, re-checked by the kernel\n" ++
    s!"  in `Cases.Zip2005.Frame.{name}`.\n-/\n\n" ++
    "import AsmVerif.RiscV.Frame.Domain\n\nset_option maxRecDepth 200000\n\n" ++
    s!"namespace Cases.Zip2005.Frame.{name}\n\nopen RiscvZkvm.Rv64 AsmVerif.RiscV.Frame\n\n" ++
    s!"def anno : Array (Option AState) := #[\n  {body}]\n\nend Cases.Zip2005.Frame.{name}\n"
  IO.FS.writeFile s!"Cases/Zip2005/Frame/{name}Anno.lean" src
  IO.println s!"{name}: {anno.size} entries, {r.reqs.length} reqs, {r.residual.length} residual, {r.noreturn.length} noreturn"

def main : IO Unit := do
  emit "Memcpy" Fns.memcpy
  emit "PadNext" Fns.padNext
  emit "DefaultHook" Fns.defaultHook
  emit "FmtWrite" Fns.fmtWrite

end Cases.Zip2005.Frame.Gen

def main : IO Unit := Cases.Zip2005.Frame.Gen.main
