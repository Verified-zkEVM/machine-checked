/-!
# `main`'s acceptance facts and the named models the segments pass along

`AcceptE` bundles what segment E learns on the accepting path. `psiX`, `tbX` and `rcmX` are the
outputs of `RandomSeed::psi`, `Ep::to_bytes` and `RandomSeed::rcm_v3` exactly as their
specifications state them (definitionally); `RcmRel` packages `rcm_v3_spec`'s ghost encodings.
These are the terms the models-to-spec layer bridges to `hPsiOrchard`, the point encoding and
`hRcmOrchard`.
-/

namespace Cases.Zip2005

open RiscvZkvm.Rv64 RiscvZkvm.Rv64.Accel Cases.Zip2005.Image AsmVerif.RiscV.Sym Cases.Zip2005.B2b

set_option autoImplicit false

/-- What segment E establishes on the accepting path: the note commitment is not `⊥`, the
instance nullifier `f` is canonical, and the nullifier derived from `nk`, `ρ`, `ψ` and the
commitment equals it (both in Montgomery form); and the two scalar multiplications it rests on
(`[rcm] R`, `[nf scalar] K^Orchard`) ran as their model says (`mulFacts`). -/
def AcceptE (n r q g p k f : List Word) (v : Word) : Prop :=
  commitFlag qNoteW (noteMsgW g p v r q) = 1#8 ∧ leLimbsToNat f < Fp.p ∧
    natToLeLimbs 4 (nullifierX (leLimbsToNat n) (leLimbsToNat r) (leLimbsToNat q)
      (cmSel qNoteW rNoteW (noteMsgW g p v r q) k)) = natToLeLimbs 4 (Fp.mul (leLimbsToNat f) Fp.R2) ∧
    mulFacts rNoteW k ∧ mulFacts kOrchardW (nullifierScalarW (leLimbsToNat n) (leLimbsToNat r) (leLimbsToNat q))

