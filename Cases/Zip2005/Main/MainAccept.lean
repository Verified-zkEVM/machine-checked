/-- What segment C establishes on the accepting path, from the instance nullifier `f`, `nk`, the
witness `ρ` bytes `rb` and seed `sd`, the scalar `ivk` limbs `i` and the value `v`: some `ρ`, `ψ`,
`g_d` (cells `l`), `pk_d = [ivk] g_d` (`m`), their encodings `c`, `d` and `rcm` (`x`), each by its
defining equation, with `AcceptE` over them. Also: `ρ`'s bytes are canonical, `g_d` is what
`from_bytes` decoded from the witness bytes `gb` with a non-identity flag, and `[ivk] g_d` ran
as its model says. -/
def AcceptC (n f rb sd i gb : List Word) (v : Word) : Prop :=
  ∃ (r0 r1 r2 r3 q0 q1 q2 q3 c0 c1 c2 c3 d0 d1 d2 d3 k0 k1 k2 k3 : Word)
      (l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11 : Word) (m : List Word) (x : Nat),
    AcceptE n [r0, r1, r2, r3] [q0, q1, q2, q3] [c0, c1, c2, c3] [d0, d1, d2, d3]
      [k0, k1, k2, k3] f v ∧
    leLimbsToNat [r0, r1, r2, r3] = Fp.mul (leLimbsToNat rb) Fp.R2 ∧
    leLimbsToNat [q0, q1, q2, q3] = psiX sd[0]! sd[1]! sd[2]! sd[3]! r0 r1 r2 r3 ∧
    [c0, c1, c2, c3] = natToLeLimbs 4 (tbX l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11) ∧
    mulW [l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11] i = m ∧
    [d0, d1, d2, d3] = natToLeLimbs 4 (tbX m[0]! m[1]! m[2]! m[3]! m[4]! m[5]! m[6]! m[7]! m[8]! m[9]! m[10]! m[11]!) ∧
    [k0, k1, k2, k3] = natToLeLimbs 4 x ∧
    RcmRel sd[0]! sd[1]! sd[2]! sd[3]! r0 r1 r2 r3 q0 q1 q2 q3 l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11
      m[0]! m[1]! m[2]! m[3]! m[4]! m[5]! m[6]! m[7]! m[8]! m[9]! m[10]! m[11]! v x ∧
    leLimbsToNat rb < Fp.p ∧
    (∃ fl : BitVec 8, FromBytesPost gb[0]! gb[1]! gb[2]! gb[3]! (leLimbsToNat [l0, l1, l2, l3])
      (leLimbsToNat [l4, l5, l6, l7]) fl ∧ nipFlag fl l8 l9 l10 l11 = 1#8) ∧
    leLimbsToNat [l8, l9, l10, l11] =
      (if leLimbsToNat [l0, l1, l2, l3] = 0 ∧ leLimbsToNat [l4, l5, l6, l7] = 0 then 0 else Fp.R) ∧
    mulFacts [l0, l1, l2, l3, l4, l5, l6, l7, l8, l9, l10, l11] i

/-- What segment B establishes on the accepting path, from the full viewing key's words `w`
(`ak`'s limbs at `w`), `nk`, `rivk_ext` (`e`), the witness `rivk` (`rk`), `ak`'s coordinate `ak`:
`rivk` is `FullViewingKey::rivk(Internal)` (`c`) or `rivk_ext`; `commit_ivk` is not `⊥` and gives
`ivk` (`j`), which is not zero; its scalar (`i`, through `x`, out of Montgomery form) is non-zero
and canonical; and `AcceptC` over it. -/
def AcceptB (n f rb sd w e rk ak gb : List Word) (v : Word) : Prop :=
  ∃ (c0 c1 c2 c3 j0 j1 j2 j3 i0 i1 i2 i3 : Word) (x : Nat),
    AcceptC n f rb sd [i0, i1, i2, i3] gb v ∧ mulFacts rIvkW rk ∧
    [c0, c1, c2, c3] = natToLeLimbs 4 (rivkIntX w[0]! w[1]! w[2]! w[3]! n[0]! n[1]! n[2]! n[3]!
      e[0]! e[1]! e[2]! e[3]!) ∧
    [j0, j1, j2, j3] = extractPBottomW (ivkFlag qIvkW (boolBytesToWords (ivkBit (reprW ak) (reprW n)) 65))
      (ivkW qIvkW rIvkW (boolBytesToWords (ivkBit (reprW ak) (reprW n)) 65) rk) ∧
    leLimbsToNat [j0, j1, j2, j3] * Fp.rInv % Fp.p = x ∧
    [i0, i1, i2, i3] = nzScalarW (leLimbsToNat [BitVec.ofNat 64 (x >>> (64 * 0)), BitVec.ofNat 64 (x >>> (64 * 1)), BitVec.ofNat 64 (x >>> (64 * 2)), BitVec.ofNat 64 (x >>> (64 * 3))]) ∧
    ((rk[0]! = c0 ∧ rk[1]! = c1 ∧ rk[2]! = c2 ∧ rk[3]! = c3) ∨
      (rk[0]! = e[0]! ∧ rk[1]! = e[1]! ∧ rk[2]! = e[2]! ∧ rk[3]! = e[3]!)) ∧
    (ivkFlag qIvkW (boolBytesToWords (ivkBit (reprW ak) (reprW n)) 65)) = 1#8 ∧
    ¬ (j0 = 0#64 ∧ j1 = 0#64 ∧ j2 = 0#64 ∧ j3 = 0#64) ∧
    nzScalarFlag (leLimbsToNat [BitVec.ofNat 64 (x >>> (64 * 0)), BitVec.ofNat 64 (x >>> (64 * 1)), BitVec.ofNat 64 (x >>> (64 * 2)), BitVec.ofNat 64 (x >>> (64 * 3))]) = 1#8

/-- A word of the 32-byte spending key as `main` holds it: the key sits in the frame at a byte
offset of 5 past a word boundary, so each of its words is the top three bytes of one frame word
and the low five bytes of the next. -/
def skWord (a b : Word) : Word :=
  word8 (extractByte a 5) (extractByte a 6) (extractByte a 7) (extractByte b 0) (extractByte b 1)
    (extractByte b 2) (extractByte b 3) (extractByte b 4)

/-- What segment A2c (the `sk` arm) establishes on the accepting path, for the spending key's
words `s0`..`s3` and `negate`'s low bit `neg`: `AcceptB`; `nk` and `rivk_ext` (`e`) are the ones
`sk` derives; the spend-authorizing key's point is `[ask] G` for the basepoint `G` (`g0`..`g11`,
decoded by `from_bytes` with its flag 1), and `ak`'s encoding (`w`) is that point's bytes
(`memcmp`). -/
def AcceptA2c (s0 s1 s2 s3 neg : Word) (n f rb sd w e rk ak gb : List Word) (v : Word) : Prop :=
  AcceptB n f rb sd w e rk ak gb v ∧
  n = nkW s0 s1 s2 s3 ∧ e = rivkW s0 s1 s2 s3 ∧
  ∃ (g0 g1 g2 g3 g4 g5 g6 g7 g8 g9 g10 g11 : Word),
    (FromBytesPost (10167565023098292579#64) (900452621665476876#64) (4291112941855392863#64)
      (13210504334354273798#64) (leLimbsToNat [g0, g1, g2, g3]) (leLimbsToNat [g4, g5, g6, g7]) 1#8 ∧
    (leLimbsToNat [g8, g9, g10, g11] =
      if leLimbsToNat [g0, g1, g2, g3] = 0 ∧ leLimbsToNat [g4, g5, g6, g7] = 0 then 0 else Fp.R) ∧
    mulFacts [g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11] (skW (askR neg s0 s1 s2 s3))) ∧
    w = ((askW neg s0 s1 s2 s3 [g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11]).drop 12).take 4

end Cases.Zip2005
