/-- `rcm_v3`'s output `x` from the seed `e`, `ρ`, `ψ` and the points `g_d`, `pk_d`, with the
encodings it hashes (`to_bytes` of the points, `ρ` and `ψ` out of Montgomery form). -/
def RcmRel (e0 e1 e2 e3 r0 r1 r2 r3 q0 q1 q2 q3 g0 g1 g2 g3 g4 g5 g6 g7 g8 g9 g10 g11
    k0 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11 v : Word) (x : Nat) : Prop :=
  ∃ G0 G1 G2 G3 K0 K1 K2 K3 R0 R1 R2 R3 Q0 Q1 Q2 Q3 : Word,
    natToLeLimbs 4 (tbX g0 g1 g2 g3 g4 g5 g6 g7 g8 g9 g10 g11) = [G0, G1, G2, G3] ∧
    natToLeLimbs 4 (tbX k0 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11) = [K0, K1, K2, K3] ∧
    natToLeLimbs 4 (leLimbsToNat [r0, r1, r2, r3] * Fp.rInv % Fp.p) = [R0, R1, R2, R3] ∧
    natToLeLimbs 4 (leLimbsToNat [q0, q1, q2, q3] * Fp.rInv % Fp.p) = [Q0, Q1, Q2, Q3] ∧
